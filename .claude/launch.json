{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "emdash-dev",
			"runtimeExecutable": "npx",
			"runtimeArgs": ["emdash", "dev", "--port", "4642"],
			"port": 4642,
			"autoPort": false
		},
		{
			"name": "astro-remote",
			"runtimeExecutable": "npx",
			"runtimeArgs": ["astro", "dev", "--port", "4643"],
			"port": 4643,
			"autoPort": false
		},
		{
			"name": "astro-local",
			"runtimeExecutable": "sh",
			"runtimeArgs": [
				"-c",
				"CLOUDFLARE_VITE_FORCE_LOCAL=true npx astro dev --port 4644"
			],
			"port": 4644,
			"autoPort": false
		}
	]
}
