---
/**
 * "default" page template — narrow editorial column, like the About page.
 * Registered in the `template` select on the pages collection; the route
 * at src/pages/[slug].astro picks this component when template = "default".
 */
import { Image, PortableText } from "emdash/ui";

const { page } = Astro.props;
---

<article class="page">
	<header class="page-header">
		<h1 class="page-title" {...page.edit.title}>{page.data.title}</h1>
		{
			page.data.excerpt && (
				<p class="page-excerpt" {...page.edit.excerpt}>
					{page.data.excerpt}
				</p>
			)
		}
	</header>

	{
		page.data.thumbnail && (
			<div class="page-thumbnail" {...page.edit.thumbnail}>
				<Image image={page.data.thumbnail} />
			</div>
		)
	}

	<div class="page-content" {...page.edit.content}>
		<PortableText value={page.data.content} />
	</div>
</article>

<style>
	.page {
		max-width: 720px;
		margin: 0 auto;
		padding: clamp(2rem, 5vw, 4rem) var(--spacing-xl) 0;
	}

	.page-title {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 4.5vw, 3.4rem);
		line-height: var(--leading-tight);
		margin-bottom: var(--spacing-md);
	}

	.page-excerpt {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
		margin-bottom: var(--spacing-lg);
	}

	.page-thumbnail {
		margin: var(--spacing-xl) 0;
	}

	.page-content {
		line-height: var(--leading-relaxed);
	}

	.page-content :global(p) {
		margin-bottom: 1.4em;
	}

	.page-content :global(h2),
	.page-content :global(h3) {
		font-family: var(--font-heading);
		margin: 1.8em 0 0.6em;
	}

	.page-content :global(blockquote) {
		margin: 2em 0;
		padding-left: var(--spacing-xl);
		border-left: 2px solid var(--color-brand);
		color: var(--color-muted);
	}

	.page-content :global(a) {
		color: var(--color-brand);
	}
</style>
