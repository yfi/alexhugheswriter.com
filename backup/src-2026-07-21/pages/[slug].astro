---
import { getEmDashEntry, getEmDashCollection, decodeSlug } from "emdash";
import Base from "../layouts/Base.astro";
import DefaultPage from "../templates/DefaultPage.astro";
import WidePage from "../templates/WidePage.astro";

// Static track prerenders every published page; server track stays on-demand.
export const prerender = false;

export async function getStaticPaths() {
	const { entries } = await getEmDashCollection("pages", {
		status: "published",
		limit: 200,
	});
	return entries.map((entry) => ({ params: { slug: entry.id } }));
}

// Template registry: option values in the pages collection's `template`
// select map to Astro components here. To add a template, create the
// component, add it to this map, and add the option in seed/seed.json
// (or Admin -> Content Types -> Pages -> Template).
const TEMPLATES = {
	default: DefaultPage,
	wide: WidePage,
};

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const Template =
	TEMPLATES[page.data.template as keyof typeof TEMPLATES] ?? DefaultPage;

function getImageSrc(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	return typeof image.src === "string" ? image.src : undefined;
}
---

<Base
	title={page.data.title}
	description={page.data.excerpt}
	image={getImageSrc(page.data.thumbnail)}
>
	<Template page={page} />
</Base>
