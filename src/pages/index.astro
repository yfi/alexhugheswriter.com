---
import AppLayout from "../layouts/AppLayout.astro";
import { getCollection, getEntry, render } from "astro:content";

const settingsEntry = await getEntry("settings", "site");
const introEntry = await getEntry("sections", "intro");
const footerEntry = await getEntry("sections", "footer");
const { Content: IntroContent } = introEntry ? await render(introEntry) : { Content: null };
const { Content: FooterContent } = footerEntry ? await render(footerEntry) : { Content: null };

const projects = (await getCollection("projects")).sort(
	(a, b) => (a.data.date?.getTime() ?? 0) - (b.data.date?.getTime() ?? 0),
);

const headshot = "/media/headshot.jpg";

const name = settingsEntry?.data.title ?? "Alex Hughes";

type DetailRow = { key: string; value: string };

// Pulls "Client" out of the flexible details list so it can sit in the
// year/title/client meta row; everything else renders as the details list.
function splitDetails(details: DetailRow[]): { client: string | null; rest: DetailRow[] } {
	const clientIndex = details.findIndex((d) => d.key.trim().toLowerCase() === "client");
	const client = clientIndex >= 0 ? details[clientIndex].value : null;
	const rest = details.filter((_, i) => i !== clientIndex);
	return { client, rest };
}
---

<AppLayout image={headshot}>
	<header slot="floating" class="island" id="island" data-state="expanded">
		<button
			class="island-bar"
			id="island-toggle"
			aria-expanded="true"
			aria-controls="island-panel"
		>
			<img class="island-avatar" src={headshot} alt="" />
			<span class="island-id">
				<span class="island-name">{name}</span>
				{settingsEntry?.data.tagline && (
					<span class="island-tagline">{settingsEntry.data.tagline}</span>
				)}
			</span>
			<span class="island-caret" aria-hidden="true"></span>
		</button>
		{
			IntroContent && (
				<div class="island-panel" id="island-panel">
					<div class="island-bio">
						<div class="island-bio-text">
							<IntroContent />
						</div>
					</div>
				</div>
			)
		}
	</header>

	{
		projects.map((project) => {
			const { client, rest } = splitDetails(project.data.details);
			const slides =
				project.data.images.length > 0
					? project.data.images
					: [{ image: project.data.thumbnail, alt: project.data.thumbnail_alt }];
			return (
				<article class="work">
					<div class="slideshow">
						<div class="carousel" tabindex="0" aria-label={`${project.data.title} images`}>
							{slides.map((slide) => (
								<div class="slide">
									<img src={slide.image} alt={slide.alt} />
								</div>
							))}
						</div>
						{slides.length > 1 && (
							<div class="dots" aria-hidden="true">
								{slides.map((_, i) => (
									<button class:list={["dot", { "is-active": i === 0 }]} data-index={i} />
								))}
							</div>
						)}
					</div>

					<div class="work-info">
						<div class="work-meta">
							{project.data.year && <span class="work-year">{project.data.year}</span>}
							<h2 class="work-title">{project.data.title}</h2>
							{client && <span class="work-client">{client}</span>}
						</div>
						{rest.length > 0 && (
							<dl class="work-details">
								{rest.map((d) => (
									<div class="detail-row">
										<dt>{d.key}</dt>
										<dd>{d.value}</dd>
									</div>
								))}
							</dl>
						)}
					</div>
				</article>
			);
		})
	}

	<footer class="site-footer">
		<div class="footer-content">
			{FooterContent ? <FooterContent /> : <p>Let’s make cool stuff!</p>}
		</div>
	</footer>
</AppLayout>

<script>
	// Floating island: expanded at the top / on click, compact once scrolled.
	const island = document.getElementById("island");
	const toggle = document.getElementById("island-toggle");
	const root = document.querySelector<HTMLElement>(".snap-root");

	if (island && toggle && root) {
		const THRESHOLD = 40;
		let manual: boolean | null = null;

		const render = () => {
			const atTop = root.scrollTop <= THRESHOLD;
			const expanded = manual === null ? atTop : manual;
			island.dataset.state = expanded ? "expanded" : "compact";
			toggle.setAttribute("aria-expanded", String(expanded));
		};

		root.addEventListener("scroll", () => { manual = null; render(); }, { passive: true });
		toggle.addEventListener("click", () => {
			const atTop = root.scrollTop <= THRESHOLD;
			const current = manual === null ? atTop : manual;
			manual = !current;
			render();
		});
		render();
	}

	// Slideshow counter dots: track the active slide and jump on click.
	document.querySelectorAll<HTMLElement>(".slideshow").forEach((show) => {
		const carousel = show.querySelector<HTMLElement>(".carousel");
		const slides = Array.from(show.querySelectorAll<HTMLElement>(".slide"));
		const dots = Array.from(show.querySelectorAll<HTMLButtonElement>(".dot"));
		if (!carousel || dots.length === 0) return;

		// Active = the slide whose centre is closest to the viewport centre
		// (robust to the peek/padding and to variable slide widths).
		const activeIndex = () => {
			const centre = carousel.scrollLeft + carousel.clientWidth / 2;
			let best = 0;
			let bestDist = Infinity;
			slides.forEach((slide, i) => {
				const c = slide.offsetLeft + slide.offsetWidth / 2;
				const d = Math.abs(c - centre);
				if (d < bestDist) {
					bestDist = d;
					best = i;
				}
			});
			return best;
		};

		const centre = (i: number, smooth: boolean) => {
			const slide = slides[i];
			if (!slide) return;
			const left = slide.offsetLeft - (carousel.clientWidth - slide.offsetWidth) / 2;
			carousel.scrollTo({ left, behavior: smooth ? "smooth" : "auto" });
		};

		const update = () => {
			const i = activeIndex();
			dots.forEach((dot, di) => dot.classList.toggle("is-active", di === i));
		};

		// Once the user scrolls/clicks, stop auto-centring the first slide.
		let touched = false;
		["pointerdown", "wheel", "touchstart", "keydown"].forEach((ev) =>
			carousel.addEventListener(ev, () => (touched = true), { passive: true }),
		);

		carousel.addEventListener("scroll", update, { passive: true });
		dots.forEach((dot, di) =>
			dot.addEventListener("click", () => {
				touched = true;
				centre(di, true);
			}),
		);

		// Natural-width slides have no width until their image loads, so keep
		// re-centring the first slide (on load/resize) until the user takes over.
		const centreFirst = () => {
			if (touched) return;
			centre(0, false);
			update();
		};
		// ResizeObserver fires after layout — and again when a slide's width
		// settles as its image loads — so the first slide centres with correct
		// dimensions regardless of load timing.
		if (slides[0]) new ResizeObserver(centreFirst).observe(slides[0]);
		window.addEventListener("resize", centreFirst);
	});
</script>

<style>
	/* ---------- Flat type: everything one size ---------- */
	.work-info,
	.work-year,
	.work-title,
	.work-client,
	.work-details,
	.detail-row,
	.detail-row dt,
	.detail-row dd,
	.island-name,
	.island-tagline,
	.island-bio-text,
	.footer-content {
		font-family: inherit;
		font-size: 1em;
		font-weight: 400;
		line-height: var(--leading-normal);
		letter-spacing: normal;
		text-transform: none;
		color: inherit;
	}

	/* ---------- Floating island header ---------- */
	.island {
		position: fixed;
		top: clamp(0.75rem, 2vw, 1.25rem);
		left: 50%;
		transform: translateX(-50%);
		z-index: 100;
		width: min(92vw, 440px);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 22px;
		box-shadow: 0 10px 34px rgba(0, 0, 0, 0.12);
		overflow: hidden;
		transition:
			width 0.35s ease,
			border-radius 0.35s ease;
	}

	.island[data-state="compact"] {
		width: min(76vw, 288px);
		border-radius: 999px;
	}

	.island-bar {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		width: 100%;
		padding: 0.55rem 0.7rem;
		background: none;
		border: none;
		cursor: pointer;
		text-align: left;
		color: inherit;
		font: inherit;
	}

	.island-avatar {
		width: 46px;
		height: 46px;
		border-radius: 50%;
		object-fit: cover;
		flex: none;
		transition:
			width 0.35s ease,
			height 0.35s ease;
	}

	.island[data-state="compact"] .island-avatar {
		width: 34px;
		height: 34px;
	}

	.island-id {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.island[data-state="compact"] .island-tagline {
		display: none;
	}

	.island-caret {
		margin-left: auto;
		flex: none;
		width: 7px;
		height: 7px;
		border-right: 2px solid var(--color-muted);
		border-bottom: 2px solid var(--color-muted);
		transform: translateY(-2px) rotate(45deg);
		transition: transform 0.35s ease;
	}

	.island[data-state="compact"] .island-caret {
		transform: translateY(1px) rotate(-135deg);
	}

	.island-panel {
		display: grid;
		grid-template-rows: 1fr;
		transition: grid-template-rows 0.35s ease;
	}

	.island[data-state="compact"] .island-panel {
		grid-template-rows: 0fr;
	}

	.island-bio {
		overflow: hidden;
		min-height: 0;
	}

	.island-bio-text {
		padding: 0 1rem 1rem;
	}

	.island-bio-text :global(p) {
		margin-bottom: 0.7em;
	}

	.island-bio-text :global(p:last-child) {
		margin-bottom: 0;
	}

	/* ---------- Work cards: slideshow over info, inset in the feed ---------- */
	.work {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-lg);
		width: calc(100% - var(--spacing-md) * 2);
		max-width: var(--max-width);
		margin: 0 auto var(--spacing-2xl);
		border: 1px solid var(--color-border);
		border-radius: 14px;
		overflow: hidden;
		background: var(--color-surface);
	}

	/* Clears the fixed floating island header at the top of the feed. */
	.work:first-of-type {
		margin-top: clamp(4.5rem, 14vw, 6rem);
	}

	.slideshow {
		position: relative;
		flex: none;
		width: 100%;
		aspect-ratio: 3 / 4; /* mobile */
		overflow: hidden;
		background: var(--color-bg);
	}

	.carousel {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		/* Half-viewport room each end so any slide (incl. first/last) can centre. */
		padding-inline: 50%;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
		background: var(--color-border);
	}

	.carousel::-webkit-scrollbar {
		display: none;
	}

	/* Uniform height, natural width — wide images run past the window edge. */
	.slide {
		flex: 0 0 auto;
		height: 100%;
		scroll-snap-align: center;
	}

	.slide :global(img) {
		height: 100%;
		width: auto;
		max-width: none;
		display: block;
	}

	.dots {
		position: absolute;
		bottom: var(--spacing-sm);
		left: 0;
		right: 0;
		display: flex;
		justify-content: center;
		gap: 7px;
	}

	.dot {
		width: 7px;
		height: 7px;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: var(--color-text);
		opacity: 0.3;
		cursor: pointer;
		transition: opacity 0.2s ease;
	}

	.dot.is-active {
		opacity: 1;
	}

	.work-info {
		padding: 0 var(--spacing-lg) var(--spacing-lg);
	}

	.work-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--spacing-xs) var(--spacing-md);
	}

	.work-year,
	.work-client {
		flex: 0 0 auto;
		color: var(--color-muted);
	}

	.work-title {
		flex: 1 1 auto;
	}

	.work-details {
		display: flex;
		flex-direction: column;
		gap: 2px;
		margin-top: 0.6em;
	}

	.detail-row {
		display: flex;
		gap: 0.4em;
	}

	.detail-row dt::after {
		content: ":";
	}

	/* ---------- Footer panel ---------- */
	.site-footer {
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		background: var(--color-brand);
		color: var(--color-on-brand);
		padding: var(--spacing-2xl) var(--spacing-xl);
	}

	.footer-content {
		max-width: 46ch;
	}

	.footer-content :global(a) {
		color: var(--color-on-brand);
	}

	/* ---------- Desktop: full-width 16:9 slideshow ---------- */
	@media (min-width: 820px) {
		.slideshow {
			aspect-ratio: 16 / 9;
		}

		.work-info {
			padding: 0 var(--spacing-2xl) var(--spacing-2xl);
		}
	}
</style>
