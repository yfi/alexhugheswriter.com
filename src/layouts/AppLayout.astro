---
/**
 * Single-page app shell: <head> + a full-viewport scrolling feed
 * container. Unlike Base.astro it ships no nav/footer chrome — the
 * floating header, work cards, and footer are the feed content itself.
 */
import { getEntry } from "astro:content";
import { Font } from "astro:assets";
import SeoHead from "../components/SeoHead.astro";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title, description, image } = Astro.props;
const settingsEntry = await getEntry("settings", "site");
const siteTitle = settingsEntry?.data.title || "Alex Hughes";
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const siteDescription = description || settingsEntry?.data.tagline || "Toronto based writer";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<SeoHead
			title={fullTitle}
			description={siteDescription}
			canonical={Astro.url.href}
			siteName={siteTitle}
			image={image}
		/>
		<Font cssVariable="--font-heading" preload />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${siteTitle} RSS Feed`}
			href="/rss.xml"
		/>
	</head>
	<body>
		<slot name="floating" />
		<div class="snap-root">
			<slot />
		</div>
	</body>
</html>

<style is:global>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		font-family: var(--font-body);
		background: var(--color-bg);
		color: var(--color-text);
	}

	a {
		color: inherit;
	}

	img {
		max-width: 100%;
		display: block;
	}
</style>

<style>
	/* Vertically scrolling feed container -- a normal document scroll, not
	   one-panel-per-screen. */
	.snap-root {
		height: 100svh;
		overflow-y: scroll;
		scroll-behavior: smooth;
	}

	@media (prefers-reduced-motion: reduce) {
		.snap-root {
			scroll-behavior: auto;
		}
	}
</style>
