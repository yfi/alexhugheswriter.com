---
import { getEntry } from "astro:content";
import { Font } from "astro:assets";
import SeoHead from "../components/SeoHead.astro";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
}

const { title, description, image, type = "website" } = Astro.props;
const settingsEntry = await getEntry("settings", "site");
const siteTitle = settingsEntry?.data.title || "Alex Hughes";
const siteTitleParts = siteTitle.trim().split(" ");
const siteTitleLastName = siteTitleParts.pop();
const siteTitleFirstNames = siteTitleParts.join(" ");
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const siteDescription = description || settingsEntry?.data.tagline || "Toronto based writer";

const menu = [
	{ label: "Work", url: "/" },
	{ label: "About", url: "/about" },
];
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<SeoHead
			title={fullTitle}
			description={siteDescription}
			canonical={Astro.url.href}
			siteName={siteTitle}
			image={image}
			type={type}
		/>
		<Font cssVariable="--font-heading" preload />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${siteTitle} RSS Feed`}
			href="/rss.xml"
		/>
	</head>
	<body>
		<header class="site-header">
			<nav class="nav">
				<a href="/" class="site-title">
					{siteTitleFirstNames && `${siteTitleFirstNames} `}<span class="site-title-accent">{siteTitleLastName}</span>
				</a>
				<div class="nav-links">
					{
						menu.map((item) => {
							const isActive =
								item.url === "/"
									? currentPath === "/" || currentPath.startsWith("/projects/")
									: currentPath === item.url;
							return (
								<a href={item.url} class:list={{ active: isActive }}>
									{item.label}
								</a>
							);
						})
					}
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		font-family: var(--font-body);
		background: var(--color-bg);
		color: var(--color-text);
	}

	body {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		font-size: var(--font-size-base);
		line-height: var(--leading-normal);
	}

	main {
		flex: 1;
	}

	a {
		color: inherit;
	}

	img {
		max-width: 100%;
		display: block;
	}
</style>

<style>
	.site-header {
		padding: var(--spacing-lg) var(--spacing-xl);
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-lg);
	}

	.site-title {
		font-family: var(--font-heading);
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.01em;
		text-decoration: none;
		color: var(--color-text);
	}

	.site-title-accent {
		color: var(--color-brand);
	}

	.nav-links {
		display: flex;
		gap: var(--spacing-lg);
	}

	.nav-links a {
		font-family: var(--font-heading);
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		text-decoration: none;
		color: var(--color-text);
		padding-bottom: 1px;
	}

	.nav-links a.active {
		border-bottom: 3px solid var(--color-brand);
	}

	.site-header {
		display: none;
	}
</style>
