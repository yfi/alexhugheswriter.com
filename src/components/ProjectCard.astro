---
import type { MediaValue } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	title: string;
	thumbnail?: MediaValue | string;
	href: string;
}

const { title, thumbnail, href } = Astro.props;
---

<a href={href} class="grid-item">
	<div class="grid-image">
		{thumbnail && <Image image={thumbnail} />}
	</div>
	<h3 class="grid-title">{title}</h3>
</a>

<style>
	.grid-item {
		display: block;
		text-decoration: none;
		color: var(--color-text);
	}

	.grid-image {
		aspect-ratio: 541 / 430;
		overflow: hidden;
		background: rgba(0, 0, 0, 0.04);
	}

	.grid-image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: opacity 0.2s ease;
	}

	.grid-item:hover :global(img) {
		opacity: 0.85;
	}

	.grid-title {
		font-family: var(--font-heading);
		font-size: 1.1rem;
		text-align: center;
		margin-top: var(--spacing-md);
	}

	.grid-item:hover .grid-title {
		color: var(--color-brand);
	}
</style>
