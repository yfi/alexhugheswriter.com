---
import { getEntry, render } from "astro:content";

const settingsEntry = await getEntry("settings", "site");
const introEntry = await getEntry("sections", "intro");
const { Content: IntroContent } = introEntry ? await render(introEntry) : { Content: null };

const name = settingsEntry?.data.title ?? "Alex Hughes";
const headshot = "/media/headshot.jpg";
const SHOW_CURRENTLY_READING = false;
---

<aside class="sidebar">
	<button class="hero-avatar" id="avatar-toggle" aria-label="Zoom photo">
		<img src={headshot} alt={name} />
	</button>
	<h1 class="hero-title">
		Hi, I’m<br />
		<span class="hero-name">{name}.</span>
	</h1>
	<div class="hero-bio">{IntroContent && <IntroContent />}</div>
	<div class="sidebar-more">
		<div class="sidebar-more-inner">
			<p class="sidebar-list-label">My clients include:</p>
			<ul class="sidebar-list">
				<li>Moosehead</li>
				<li>SiriusXM</li>
				<li>Purpose Investments</li>
				<li>Metropolitan Museum of Art</li>
			</ul>
			<p class="sidebar-list-label">My writing has appeared in:</p>
			<ul class="sidebar-list">
				<li>Vice</li>
				<li>CBC Comedy</li>
				<li>Hazlitt</li>
			</ul>
			{SHOW_CURRENTLY_READING && settingsEntry?.data.currently_reading && (
				<p class="reading-note">
					Currently reading: <em>{settingsEntry.data.currently_reading}</em>
				</p>
			)}
		</div>
	</div>
	<div class="sidebar-contact-block">
		<a class="sidebar-contact" href="mailto:alex.typical@gmail.com">Get In Touch</a>
	</div>
</aside>

<script>
	const avatarToggle = document.getElementById("avatar-toggle");
	avatarToggle?.addEventListener("click", () => {
		avatarToggle.classList.toggle("is-zoomed");
	});

	document.addEventListener("click", (e) => {
		if (
			avatarToggle?.classList.contains("is-zoomed") &&
			e.target instanceof Node &&
			!avatarToggle.contains(e.target)
		) {
			avatarToggle.classList.remove("is-zoomed");
		}
	});
</script>

<style>
	.sidebar {
		display: flex;
		flex-direction: column;
		max-width: 360px;
		padding-left: var(--spacing-sm);
	}

	.hero-avatar {
		flex-shrink: 0;
		display: block;
		width: 140px;
		height: 140px;
		border-radius: 50%;
		overflow: hidden;
		margin-bottom: var(--spacing-lg);
		border: none;
		background: none;
		padding: 0;
		cursor: pointer;
		transition:
			width 0.3s ease,
			height 0.3s ease;
	}

	.hero-avatar.is-zoomed {
		width: 100%;
		height: auto;
		aspect-ratio: 1 / 1;
	}

	.hero-avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 35%;
	}

	.hero-title {
		font-family: var(--font-heading);
		font-size: 3rem;
		line-height: var(--leading-tight);
	}

	.hero-name {
		display: inline-block;
		max-width: 6ch;
		color: var(--color-brand);
	}

	.hero-bio {
		font-family: var(--font-heading);
		font-size: clamp(1rem, 1.15vw, 1.1rem);
		text-transform: uppercase;
		letter-spacing: 0.01em;
		line-height: 1.25;
		margin-top: var(--spacing-lg);
	}

	.hero-bio :global(p) {
		margin-bottom: 1.2em;
	}

	.hero-bio :global(p:last-child) {
		margin-bottom: 0;
	}

	.hero-bio :global(em) {
		color: var(--color-brand);
		font-style: normal;
	}

	.sidebar-more {
		margin-top: var(--spacing-lg);
	}

	.sidebar-more-inner {
		font-family: var(--font-heading);
		font-size: clamp(1rem, 1.15vw, 1.1rem);
		text-transform: uppercase;
		letter-spacing: 0.01em;
		line-height: 1.25;
	}

	.sidebar-more-inner p {
		margin-bottom: 1.2em;
	}

	.sidebar-more-inner p:last-child {
		margin-bottom: 0;
	}

	.sidebar-list-label {
		margin-bottom: 0.4em;
	}

	.sidebar-list {
		list-style: none;
		padding-left: 0;
		margin-bottom: 1.2em;
	}

	.sidebar-list li {
		color: var(--color-brand);
	}

	.sidebar-more-inner em {
		color: var(--color-brand);
		font-style: normal;
	}

	.reading-note {
		border: 2px solid var(--color-brand);
		border-radius: 8px;
		padding: var(--spacing-sm) var(--spacing-md);
	}

	.sidebar-more-inner .reading-note:last-child {
		margin-bottom: var(--spacing-md);
	}

	.sidebar-contact-block {
		margin-top: var(--spacing-lg);
	}

	.sidebar-contact {
		display: inline-block;
		font-family: var(--font-heading);
		font-size: var(--font-size-sm);
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--color-on-brand);
		background: var(--color-brand);
		border-radius: 999px;
		padding: var(--spacing-sm) var(--spacing-xl);
		margin-left: calc(var(--spacing-sm) * -1);
		text-decoration: none;
	}

	.sidebar-contact:hover {
		opacity: 0.85;
	}

	@media (max-width: 900px) {
		.sidebar {
			max-width: none;
			padding-bottom: 5rem;
		}

		.sidebar-contact-block {
			position: fixed;
			bottom: 0;
			left: 0;
			right: 0;
			margin-top: 0;
			display: flex;
			justify-content: center;
			padding: var(--spacing-md) var(--spacing-lg);
			background: var(--color-bg);
			border-top: 1px solid var(--color-border);
			z-index: 50;
		}

		.sidebar-contact {
			margin-left: 0;
		}
	}
</style>
